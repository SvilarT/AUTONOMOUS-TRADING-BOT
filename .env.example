# Autonomous Trading Bot environment template
# This is for educational/backtesting/paper-trading use only. Live trading involves substantial risk of loss. Not financial advice.

# ---- Core runtime ----
DEBUG=True
SIMULATION_MODE=True
TRADING_MODE=paper
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
MONGO_URL=mongodb://mongo:27017
DB_NAME=trading_bot

# Runtime roles: api, worker, all, indexes
# Local Docker Compose overrides this per service.
RUNTIME_ROLE=all
API_EMBED_BOT_MANAGER=True
RUN_MONGO_INDEX_BOOTSTRAP=True

# ---- Ops admin ----
OPS_ADMIN_ENABLED=False
OPS_ADMIN_EMAILS=

# ---- Coinbase readonly/live credentials ----
# Store real secrets in a secret manager. Do not commit real values.
COINBASE_EXCHANGE_URL=https://api.exchange.coinbase.com
COINBASE_EXCHANGE_API_KEY=
COINBASE_EXCHANGE_API_SECRET=
COINBASE_EXCHANGE_PASSPHRASE=

# ---- Manual gated live-trading controls ----
LIVE_TRADING_ENABLED=False
LIVE_EXECUTION_ADAPTER=disabled
LIVE_ALLOWED_SYMBOLS=BTC-USD,ETH-USD
LIVE_MAX_ORDER_NOTIONAL_USD=25
LIVE_MANUAL_APPROVAL_REQUIRED=True
LIVE_SIGNED_APPROVAL_REQUIRED=True
LIVE_APPROVAL_TOKEN=
COINBASE_LIVE_ORDER_KILL_SWITCH=True

# ---- Frontend ----
REACT_APP_BACKEND_URL=http://localhost:8000
