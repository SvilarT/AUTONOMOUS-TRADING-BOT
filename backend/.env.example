# Backend runtime: production-safe defaults
DEBUG=False
JWT_SECRET=
JWT_SECRET_FILE=
CORS_ORIGINS=http://localhost:3000
MONGO_URL=mongodb://localhost:27017
DB_NAME=trading_bot
SIMULATION_MODE=True
TRADING_MODE=paper
RUNTIME_ROLE=api
API_EMBED_BOT_MANAGER=False
RUN_MONGO_INDEX_BOOTSTRAP=False

# Ops administration and optional persisted-alert webhook delivery
OPS_ADMIN_ENABLED=False
OPS_ADMIN_EMAILS=
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_URL_FILE=

# Paper execution tuning
PAPER_FEE_BPS=10
PAPER_BUY_SLIPPAGE_BPS=8
PAPER_SELL_SLIPPAGE_BPS=8
PAPER_MIN_NOTIONAL_USD=5
PAPER_PARTIAL_FILL_THRESHOLD_USD=250
PAPER_PARTIAL_FILL_RATIO=0.65
PAPER_LATENCY_MS=0

# Coinbase Exchange readonly/live credentials
# Prefer *_FILE mounted secrets. Trading keys must not have withdrawals or transfers enabled.
COINBASE_EXCHANGE_API_KEY=
COINBASE_EXCHANGE_API_KEY_FILE=
COINBASE_EXCHANGE_API_SECRET=
COINBASE_EXCHANGE_API_SECRET_FILE=
COINBASE_EXCHANGE_PASSPHRASE=
COINBASE_EXCHANGE_PASSPHRASE_FILE=
COINBASE_EXCHANGE_URL=https://api.exchange.coinbase.com

# Live trading gates: fail closed by default
LIVE_TRADING_ENABLED=False
LIVE_EXECUTION_ADAPTER=disabled
LIVE_ALLOWED_SYMBOLS=BTC-USD,ETH-USD
LIVE_MAX_ORDER_NOTIONAL_USD=25
LIVE_MANUAL_APPROVAL_REQUIRED=True
LIVE_SIGNED_APPROVAL_REQUIRED=True
LIVE_APPROVAL_TOKEN=
LIVE_APPROVAL_TOKEN_FILE=
COINBASE_LIVE_ORDER_KILL_SWITCH=True

# Elevated live execution session
LIVE_MFA_REQUIRED=True
LIVE_TOTP_SECRET=
LIVE_TOTP_SECRET_FILE=
LIVE_ELEVATED_SESSION_TTL_SECONDS=300

# Live request abuse protection
LIVE_RATE_LIMITING_ENABLED=True
LIVE_RATE_LIMIT_PER_USER=3
LIVE_RATE_LIMIT_PER_IP=5
LIVE_RATE_LIMIT_GLOBAL=10
LIVE_RATE_LIMIT_WINDOW_SECONDS=60
LIVE_IDEMPOTENCY_REQUIRED=True
LIVE_IDEMPOTENCY_RETENTION_DAYS=7

# Automated circuit breaker
LIVE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
LIVE_CIRCUIT_BREAKER_WINDOW_SECONDS=300
LIVE_MAX_RECONCILIATION_AGE_SECONDS=300
LIVE_REQUIRE_FRESH_RECONCILIATION=True

# Operator attestations: required before TRADING_MODE=live-trading can boot
LIVE_OPERATOR_ATTESTATION_ACCEPTED=False
LIVE_CREDENTIALS_WITHDRAWALS_DISABLED_CONFIRMED=False
LIVE_CREDENTIALS_TRANSFERS_DISABLED_CONFIRMED=False
LIVE_CREDENTIALS_IP_ALLOWLIST_CONFIRMED=False
